# infra/ops/stock.env.example → installed once to /etc/stock/stock.env (mode 600, owner = STOCK_USER).
# Server-side settings for the ops scripts in infra/ops/bin. The app's own settings stay in
# /opt/stock/apps/ingest-worker/.env. install.sh never overwrites an existing /etc/stock/stock.env.

# ---- Telegram alerts (empty = alerts are only written to the journal) ----
# Bot token from @BotFather; chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Paths ----
STOCK_DIR=/opt/stock
BACKUP_DIR=/data/backups/daily

# ---- Backups ----
BACKUP_KEEP_DAYS=7
# rclone destination for off-server copies, e.g. oci:stock-backups/daily ; empty = local copies only
RCLONE_REMOTE=
REMOTE_KEEP_DAYS=30

# ---- Health checks ----
DISK_ALERT_PCT=80
# Alert when the newest local backup is older than this many hours
BACKUP_MAX_AGE_HOURS=26
