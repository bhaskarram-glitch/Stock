# infra/ops/systemd/stock-check-accounts.service — installed by infra/ops/install.sh
[Unit]
Description=Verify every Upstox token works
Wants=docker.service
After=docker.service network-online.target
OnFailure=stock-notify-failure@%n.service

[Service]
Type=oneshot
User=__STOCK_USER__
ExecStart=/usr/local/bin/stock-job check-accounts
TimeoutStartSec=30min
