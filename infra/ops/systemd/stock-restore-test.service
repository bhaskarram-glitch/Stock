# infra/ops/systemd/stock-restore-test.service — installed by infra/ops/install.sh
[Unit]
Description=Restore the newest backup into a scratch DB and verify it
Wants=docker.service
After=docker.service network-online.target
OnFailure=stock-notify-failure@%n.service

[Service]
Type=oneshot
User=__STOCK_USER__
ExecStart=/usr/local/bin/stock-restore-test
TimeoutStartSec=2h
Nice=10
