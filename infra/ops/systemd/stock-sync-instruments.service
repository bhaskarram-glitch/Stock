# infra/ops/systemd/stock-sync-instruments.service — installed by infra/ops/install.sh
[Unit]
Description=Sync the Upstox instrument master into instruments
Wants=docker.service
After=docker.service network-online.target
OnFailure=stock-notify-failure@%n.service

[Service]
Type=oneshot
User=__STOCK_USER__
ExecStart=/usr/local/bin/stock-job sync-instruments
TimeoutStartSec=1h
