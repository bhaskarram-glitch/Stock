# infra/ops/systemd/stock-summary.service — installed by infra/ops/install.sh
[Unit]
Description=Daily status message to Telegram
Wants=docker.service
After=docker.service network-online.target
OnFailure=stock-notify-failure@%n.service

[Service]
Type=oneshot
User=__STOCK_USER__
ExecStart=/usr/local/bin/stock-healthcheck --summary
TimeoutStartSec=5min
