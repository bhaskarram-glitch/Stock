# ---- Supabase (required) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Worker ----
# healthcheck | websocket-stream
WORKER_MODE=healthcheck
# CSV of Upstox instrument keys to stream; empty = 3 built-in defaults (local dev only)
UPSTOX_INSTRUMENT_KEYS=

# ---- Upstox accounts ----
# Preferred: JSON registry. roles: ws (streaming) | hist (historical/backfill) | trade (orders). plus: true = Upstox Plus.
# UPSTOX_ACCOUNTS=[{"alias":"primary","token":"...","roles":["ws","trade"],"plus":true},{"alias":"analytics","token":"...","roles":["hist","ws"]}]
# Fallback when UPSTOX_ACCOUNTS is unset:
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
# UPSTOX_BASE_URL=https://api.upstox.com

# ---- Jobs ----
# sync-instruments: complete | NSE | BSE | MCX (CSV). "complete" already contains everything.
INSTRUMENT_SOURCES=complete

# ---- Supabase CLI (optional, for `supabase gen types`) ----
# SUPABASE_ACCESS_TOKEN=