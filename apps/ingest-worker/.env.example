# Environment Variables for Stock Ingest Worker
# Copy this file to .env and fill in your actual values

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (has admin privileges - keep secure!)
# WARNING: Never commit this to version control
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# UPSTOX API CONFIGURATION
# ==========================================
# Your Upstox access token (JWT)
# Get this from Upstox developer dashboard
UPSTOX_ACCESS_TOKEN=your-upstox-access-token-here

# Upstox API base URL (usually doesn't change)
UPSTOX_BASE_URL=https://api.upstox.com/v2

# ==========================================
# WORKER MODE CONFIGURATION
# ==========================================
# Worker mode: healthcheck, upstox-quote, websocket-stream, snapshot-smoke
WORKER_MODE=websocket-stream

# ==========================================
# OPTIONAL CONFIGURATION
# ==========================================
# Comma-separated list of instrument keys for websocket-stream mode
# Format: EXCHANGE_SEGMENT|INSTRUMENT_TOKEN
UPSTOX_INSTRUMENT_KEYS=NSE_EQ|INE002A01018,NSE_EQ|INE009A01021,NSE_EQ|INE238A01034

INSTRUMENT_SOURCES=complete