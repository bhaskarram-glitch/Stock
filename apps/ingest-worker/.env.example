# apps/ingest-worker/.env.example — copy to .env (gitignored) and fill in. On the server: chmod 600 .env

# ---- Database (self-hosted Postgres) ----
# App role: read/write data only. Used by the worker and every job except migrations.
#   server (inside Docker):  postgresql://stock_app:<pw>@stock-pg:5432/stock
#   server (host shell):     postgresql://stock_app:<pw>@127.0.0.1:5432/stock
#   laptop dev DB:           postgresql://stock_app:dev_app@localhost:5433/stock
DATABASE_URL=
# Schema owner: used only by `npm run db:migrate` / the `migrate` compose job.
MIGRATION_DATABASE_URL=
# Passwords with special characters must be URL-encoded (@ → %40, : → %3A, / → %2F).

# ---- Worker ----
# healthcheck | websocket-stream
WORKER_MODE=healthcheck
# CSV of Upstox instrument keys to stream; empty = 3 built-in defaults (local dev only)
UPSTOX_INSTRUMENT_KEYS=

# ---- Upstox accounts ----
# One block per account (numbers 1..20, gaps allowed). Roles: ws (streaming) | hist (history/backfill)
# | trade (orders). Analytics Tokens are read-only, so use hist,ws for them.
UPSTOX_ACCOUNT_1_TOKEN=
UPSTOX_ACCOUNT_1_ALIAS=acct1
UPSTOX_ACCOUNT_1_ROLES=hist,ws
UPSTOX_ACCOUNT_1_PLUS=true
# UPSTOX_ACCOUNT_2_TOKEN=
# UPSTOX_ACCOUNT_2_ALIAS=acct2
# UPSTOX_ACCOUNT_2_ROLES=hist,ws
# UPSTOX_ACCOUNT_2_PLUS=true
#
# Alternatives (first non-empty source wins; sources are never merged):
#   UPSTOX_ACCOUNTS='[{"alias":"a1","token":"...","roles":["hist","ws"],"plus":true}]'
#   UPSTOX_ACCESS_TOKEN= / UPSTOX_ANALYTICS_TOKEN=   (legacy single-token vars)
# UPSTOX_BASE_URL=https://api.upstox.com

# ---- Jobs ----
# sync-instruments: complete | NSE | BSE | MCX (CSV). "complete" already contains everything.
INSTRUMENT_SOURCES=complete
