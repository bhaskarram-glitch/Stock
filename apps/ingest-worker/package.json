{
  "name": "ingest-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx nodemon --watch src --ext ts --exec node --loader ts-node/esm src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "npm run build && node dist/apps/ingest-worker/src/index.js",
    "healthcheck": "npm run build && node dist/apps/ingest-worker/src/index.js",
    "sync:instruments": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" node src/jobs/sync-instruments.ts",
    "websocket:stream": "cross-env WORKER_MODE=websocket-stream npm run dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:websocket-smoke": "vitest run src/providers/upstox/websocket-smoke.test.ts",
    "probe:history": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" node src/jobs/probe-history.ts",
    "backfill": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" node src/jobs/backfill-history.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "protobufjs": "^8.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.3",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
